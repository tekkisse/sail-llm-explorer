# Copy to .env and change every secret before running anything beyond a laptop demo.

# --- Secrets -----------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
GATEWAY_PASSWORD=change-me-gateway
PROFILER_PASSWORD=change-me-profiler
# Generate with: openssl rand -hex 32   (must be at least 32 characters)
SERVICE_JWT_SECRET=change-me-to-at-least-32-random-bytes
AGENT_API_KEY=change-me-agent-api-key
# Generate with: openssl rand -hex 32 (Chainlit warns below 32 bytes)
CHAINLIT_AUTH_SECRET=change-me-chainlit-secret-at-least-32-bytes

# --- LLM (any OpenAI-compatible endpoint inside the TRE) ---------------------
# vLLM:   LLM_BASE_URL=http://vllm:8000/v1   LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
# Ollama: LLM_BASE_URL=http://ollama:11434/v1 LLM_MODEL=qwen2.5:14b-instruct
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:14b-instruct
LLM_API_KEY=not-needed
LLM_TIMEOUT_SECONDS=180
# Check from inside the stack: docker compose exec ui python -m sailx.check

# --- Metadata source ---------------------------------------------------------
# Demo catalogue (default) or your OpenMetadata MCP endpoint:
# METADATA_MCP_URL=http://openmetadata-server:8585/mcp
# METADATA_MCP_TOKEN=<OpenMetadata bot or personal access token>
METADATA_MCP_URL=http://catalog-mcp:8101/mcp

# --- Phenotype Library -------------------------------------------------------
# Demo fixtures (default). For the real library, clear this and set PHENOTYPE_API_BASE
# to the public API or an internal mirror reachable from the TRE.
PHENOTYPE_FIXTURES=/app/demo/phenotypes.json
# PHENOTYPE_API_BASE=https://phenotypes.healthdatagateway.org/api/v1

# --- Behaviour ---------------------------------------------------------------
REQUIRE_SQL_APPROVAL=true
SDC_THRESHOLD=10
SDC_ROUNDING=5
UI_AUTH_MODE=password
UI_DEMO_USERS=alice@example.org:alice-demo,bob@example.org:bob-demo
WEB_UI_URL=http://localhost:8000
